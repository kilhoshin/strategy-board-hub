# Copy to .env.local and fill in before deploying.

# Origin used for canonical URLs, hreflang and the sitemap. Required.
NEXT_PUBLIC_SITE_URL=https://strategyboardhub.com

# Google AdSense. Leave blank until the site is approved — no ad script loads
# and no slots render while these are unset.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_AD_SLOT_TOP=
NEXT_PUBLIC_AD_SLOT_MID=
NEXT_PUBLIC_AD_SLOT_UNDER_BOARD=
NEXT_PUBLIC_AD_SLOT_IN_ARTICLE=
